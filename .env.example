# Copy this file to .env before running the project.
# Fill in the values you actually want to use.

# Core
APP_NAME=Draeven Jarvis
HOST=0.0.0.0
PORT=8000

# Default local model
DEFAULT_LLM=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional external models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-pro

# Optional Obsidian vault
OBSIDIAN_VAULT_PATH=C:\\Users\\YourName\\Documents\\ObsidianVault
OBSIDIAN_ENABLED=false

# Optional Shopify/Etsy config
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_URL=
ETSY_API_KEY=
ETSY_SHOP_ID=
